import pyvisa as visa

# connect to multimeter
rm = visa.ResourceManager()
daq = rm.open_resource("TCPIP::192.168.0.126::inst0::INSTR")
daq.timeout = 10000  # ms

channel = 101

# configure

daq.write("*RST")

# Set function to temperature on the channel
daq.write(f'SENS:FUNC "TEMP", (@{channel})')

# transducer type
daq.write(f"SENS:TEMP:TRAN TC, (@{channel})")

# thermocouple type
daq.write(f"SENS:TEMP:TC:TYPE K, (@{channel})")

# refrence temp
daq.write(f"SENS:TEMP:TC:RJUN:RSEL INT, (@{channel})")

# tell detection on your channel's leads to be on
daq.write(f"SENS:TEMP:ODET ON, (@{channel})")


print("1")

# --- Take a reading ---
daq.write(f"ROUT:CLOS (@{channel})")  # create scan list with this channel
print("2")
reading = daq.query(f"READ? (@{channel})")

print("3")
print(f"Temperature: {reading.strip()} °C")
print("4")

daq.close()


