{
  "python.envFile": "${workspaceFolder}/.vscode/.env",
  "python-envs.defaultEnvManager": "ms-python.python:conda",
  "python-envs.defaultPackageManager": "ms-python.python:conda",
  "python-envs.pythonProjects": [],

  "python.analysis.typeCheckingMode": "off",
  "python.defaultInterpreterPath": "C:\\Users\\saroj\\.conda\\envs\\dioptric\\python.exe",
  "python.terminal.activateEnvironment": true,

  "terminal.integrated.profiles.windows": {
    "Conda (dioptric, PowerShell)": {
      "source": "PowerShell",
      "icon": "terminal-powershell",
      "args": [
        "-NoExit",
        "-Command",
        "(& 'C:\\ProgramData\\miniconda3\\condabin\\conda.bat' 'shell.powershell' 'hook') | Out-String | Invoke-Expression; conda activate dioptric"
      ]
    }
  },

  "terminal.integrated.defaultProfile.windows": "Conda (dioptric, PowerShell)",
}